<Slide style={{ background: '#0B1020', padding: 60 }}>
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>① 今日与日历：打开就知道今天要做什么</Text>
        <Text style={{ fontSize: 14, color: '#64748B' }}>03 / 功能 1</Text>
    </Box>
    <Box style={{ width: '100%', height: 1, background: 'rgba(34,211,238,0.4)', marginTop: 14 }} />

    <Box style={{ flexDirection: 'row', gap: 16, marginTop: 22 }}>
        <Image src="assets/today.png" style={{ width: 572, height: 330, objectFit: 'cover', borderRadius: 8, border: '1px solid #334155' }} />
        <Image src="assets/calendar-month.png" style={{ width: 572, height: 330, objectFit: 'cover', borderRadius: 8, border: '1px solid #334155' }} />
    </Box>

    <Box style={{ flexDirection: 'row', gap: 13, marginTop: 18 }}>
        <Box style={{ width: 278, padding: 14, background: '#151B33', borderRadius: 8, borderLeft: '3px solid #22D3EE' }}>
            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>打开就是今天</Text>
            <Text style={{ fontSize: 14, color: '#94A3B8', lineHeight: 1.5, marginTop: 8 }}>待办、课程、截止按时间排好，逾期的会单独标出来</Text>
        </Box>
        <Box style={{ width: 278, padding: 14, background: '#151B33', borderRadius: 8, borderLeft: '3px solid #22D3EE' }}>
            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>日 / 周 / 月视图</Text>
            <Text style={{ fontSize: 14, color: '#94A3B8', lineHeight: 1.5, marginTop: 8 }}>周视图看这周节奏，月视图看考试和截止分布</Text>
        </Box>
        <Box style={{ width: 278, padding: 14, background: '#151B33', borderRadius: 8, borderLeft: '3px solid #22D3EE' }}>
            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>点开能改也能连</Text>
            <Text style={{ fontSize: 14, color: '#94A3B8', lineHeight: 1.5, marginTop: 8 }}>看原始通知、跳关联笔记、改状态，改完立刻回到日历</Text>
        </Box>
        <Box style={{ width: 278, padding: 14, background: '#151B33', borderRadius: 8, borderLeft: '3px solid #22D3EE' }}>
            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>到点会提醒你</Text>
            <Text style={{ fontSize: 14, color: '#94A3B8', lineHeight: 1.5, marginTop: 8 }}>桌面版弹系统通知、托盘常驻 —— 不用一直盯着看</Text>
        </Box>
    </Box>

    <Box style={{ marginTop: 16, padding: 16, background: '#151B33', borderRadius: 8, borderLeft: '3px solid #4F46E5' }}>
        <Text style={{ fontSize: 18, color: '#E2E8F0', lineHeight: 1.5 }}>
            <span style={{ fontWeight: 'bold', color: '#22D3EE' }}>方便在哪</span>
            ：以前要在"群消息 / 日历 / 笔记"三个地方来回对，现在所有日期相关的东西都在一条时间轴上 —— 而且它们都是自动来的，不是你手打的。
        </Text>
    </Box>

    <Text style={{ fontSize: 14, color: '#64748B', position: 'absolute', left: 60, top: 670 }}>个人工作台 · v0.2.0</Text>
</Slide>
