                <text x='195' y='90' fill='#94A3B8' fontSize='14' textAnchor='middle'>472 字班级群消息</text>
                <path d='M298 71 L322 71' stroke='#475569' strokeWidth='2' />
                <path d='M316 65 L322 71 L316 77' fill='none' stroke='#475569' strokeWidth='2' />
