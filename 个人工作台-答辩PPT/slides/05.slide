                <text x='655' y='70' fill='#E2E8F0' fontSize='17' textAnchor='middle'>白名单校验 + 兜底</text>
                <text x='655' y='90' fill='#94A3B8' fontSize='14' textAnchor='middle'>失败→Ollama→本地规则</text>
                <path d='M758 71 L782 71' stroke='#475569' strokeWidth='2' />
                <path d='M776 65 L782 71 L776 77' fill='none' stroke='#475569' strokeWidth='2' />
                <rect x='790' y='40' width='180' height='62' rx='8' fill='#151B33' stroke='#334155' />
