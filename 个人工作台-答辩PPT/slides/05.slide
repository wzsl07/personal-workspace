                <text x='1085' y='90' fill='#0B1020' fontSize='14' textAnchor='middle'>不会自作主张</text>
            </g>

            <g>
                <rect x='0' y='160' width='86' height='62' rx='8' fill='#22D3EE' />
                <text x='43' y='198' fill='#0B1020' fontSize='18' fontWeight='bold' textAnchor='middle'>检索</text>
