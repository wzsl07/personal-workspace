                <path d='M758 311 L782 311' stroke='#475569' strokeWidth='2' />
                <path d='M776 305 L782 311 L776 317' fill='none' stroke='#475569' strokeWidth='2' />
                <rect x='790' y='280' width='180' height='62' rx='8' fill='#151B33' stroke='#334155' />
                <text x='880' y='310' fill='#E2E8F0' fontSize='17' textAnchor='middle'>存库 + 补正文</text>
                <text x='880' y='330' fill='#94A3B8' fontSize='14' textAnchor='middle'>→ 进搜索索引</text>
                <path d='M978 311 L1002 311' stroke='#475569' strokeWidth='2' />
                <path d='M996 305 L1002 311 L996 317' fill='none' stroke='#475569' strokeWidth='2' />
