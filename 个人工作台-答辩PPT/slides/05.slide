<Slide style={{ background: '#0B1020', padding: 60 }}>
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>② 收集箱：想到就扔进去，先记后整理</Text>
        <Text style={{ fontSize: 14, color: '#64748B' }}>04 / 功能 2</Text>
    </Box>
    <Box style={{ width: '100%', height: 1, background: 'rgba(34,211,238,0.4)', marginTop: 14 }} />

    <Box style={{ flexDirection: 'row', gap: 22, marginTop: 20 }}>
        <Image src="assets/inbox-input.png" style={{ width: 660, height: 372, objectFit: 'cover', borderRadius: 8, border: '1px solid #334155' }} />

        <Box style={{ width: 478, gap: 12 }}>
            <Box style={{ padding: 12, background: '#151B33', borderRadius: 8, borderLeft: '3px solid #4F46E5' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>怎么用：粘贴一下就完事</Text>
                <Text style={{ fontSize: 14, color: '#94A3B8', marginTop: 6 }}>复制 → 粘贴 → 回车，不要求格式、不用先分类</Text>
            </Box>
            <Box style={{ padding: 12, background: '#151B33', borderRadius: 8, borderLeft: '3px solid #4F46E5' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>截图和文件也能扔进去</Text>
                <Text style={{ fontSize: 14, color: '#94A3B8', marginTop: 6 }}>图片走本地 OCR，PDF / Word 抽出正文一起索引</Text>
            </Box>
            <Box style={{ padding: 12, background: '#151B33', borderRadius: 8, borderLeft: '3px solid #4F46E5' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>先存下来，之后再决定</Text>
                <Text style={{ fontSize: 14, color: '#94A3B8', marginTop: 6 }}>它该是日程还是笔记？解析完再看，不合适就改</Text>
            </Box>
            <Box style={{ padding: 12, background: '#151B33', borderRadius: 8, borderLeft: '3px solid #4F46E5' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>随手就能唤起</Text>
                <Text style={{ fontSize: 14, color: '#94A3B8', marginTop: 6 }}>桌面快捷键 + 悬浮小窗，断网也照记</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ marginTop: 12, padding: 14, background: '#151B33', borderRadius: 8, borderLeft: '3px solid #22D3EE' }}>
        <Text style={{ fontSize: 18, color: '#E2E8F0' }}>
            <span style={{ fontWeight: 'bold', color: '#22D3EE' }}>方便在哪</span>
            ：记东西的门槛从"打开日历 → 选日期 → 填标题 → 填地点"降到了"粘贴一下" —— 先别整理，先把脑子腾空。
        </Text>
    </Box>

    <Text style={{ fontSize: 14, color: '#64748B', position: 'absolute', left: 60, top: 670 }}>个人工作台 · v0.2.0</Text>
</Slide>
