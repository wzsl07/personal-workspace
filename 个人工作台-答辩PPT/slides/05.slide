<Slide style={{ background: '#0B1020', padding: 60 }}>
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>核心实现 · Agent 三条链路</Text>
        <Text style={{ fontSize: 14, color: '#64748B' }}>04 / 规划 → 调工具 → 校验 → 落地</Text>
    </Box>
    <Box style={{ width: '100%', height: 1, background: 'rgba(34,211,238,0.4)', marginTop: 14 }} />

    <Box style={{ marginTop: 18 }}>
        <svg width={1160} height={400} viewBox='0 0 1160 400' fontFamily='Microsoft YaHei'>
            <text x='0' y='22' fill='#94A3B8' fontSize='16'>不是开放式 ReAct 循环，而是三条固定链路 —— 个人数据场景下，可预测比通用更重要</text>

            <g>
                <rect x='0' y='40' width='86' height='62' rx='8' fill='#4F46E5' />
                <text x='43' y='78' fill='#FFFFFF' fontSize='18' fontWeight='bold' textAnchor='middle'>理解</text>
