<Slide style={{ background: '#0B1020', padding: 60 }}>
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>⑧ 桌面壳与多端：在该出现的时候出现</Text>
        <Text style={{ fontSize: 14, color: '#64748B' }}>10 / 功能 7</Text>
    </Box>
    <Box style={{ width: '100%', height: 1, background: 'rgba(34,211,238,0.4)', marginTop: 14 }} />

    <Box style={{ flexDirection: 'row', gap: 22, marginTop: 22 }}>
        <Image src="assets/settings-about.png" style={{ width: 620, height: 400, objectFit: 'cover', borderRadius: 8, border: '1px solid #334155' }} />

        <Box style={{ width: 518, gap: 14 }}>
            <Box style={{ padding: 14, background: '#151B33', borderRadius: 8, borderLeft: '3px solid #22D3EE' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>到点弹系统通知</Text>
                <Text style={{ fontSize: 14, color: '#94A3B8', lineHeight: 1.6, marginTop: 8 }}>截止前提醒走操作系统通知中心 —— 这是网页版做不到的，也是装桌面版的理由。</Text>
            </Box>
            <Box style={{ padding: 14, background: '#151B33', borderRadius: 8, borderLeft: '3px solid #22D3EE' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>托盘常驻 + 悬浮小窗</Text>
                <Text style={{ fontSize: 14, color: '#94A3B8', lineHeight: 1.6, marginTop: 8 }}>关掉窗口不退出；快捷键唤出小窗随手记一条，不用切走当前在干的事。</Text>
            </Box>
            <Box style={{ padding: 14, background: '#151B33', borderRadius: 8, borderLeft: '3px solid #22D3EE' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>开机自启 · 双击即用</Text>
                <Text style={{ fontSize: 14, color: '#94A3B8', lineHeight: 1.6, marginTop: 8 }}>便携版双击就跑，不需要管理员权限；开机自启后它就在后台待着。</Text>
            </Box>
            <Box style={{ padding: 14, background: '#151B33', borderRadius: 8, borderLeft: '3px solid #4F46E5' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>一套数据，三种形态</Text>
                <Text style={{ fontSize: 14, color: '#94A3B8', lineHeight: 1.6, marginTop: 8 }}>桌面（完整）/ 网页（零安装）/ 手机 PWA（随手记）。信息流要读本机服务，只有桌面版有。</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ marginTop: 12, padding: 16, background: '#151B33', borderRadius: 8, borderLeft: '3px solid #4F46E5' }}>
        <Text style={{ fontSize: 18, color: '#E2E8F0', lineHeight: 1.5 }}>
            <span style={{ fontWeight: 'bold', color: '#22D3EE' }}>方便在哪</span>
            ：它不用你记得打开 —— 到点自己提醒你，想记的时候一个快捷键就出来，记完自动消失。网页版和手机版负责"不在自己电脑前也能用"。
        </Text>
    </Box>

    <Text style={{ fontSize: 14, color: '#64748B', position: 'absolute', left: 60, top: 670 }}>个人工作台 · v0.2.0</Text>
</Slide>
