<Slide style={{ background: '#0B1020', padding: 60 }}>
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>总结与不足</Text>
        <Text style={{ fontSize: 14, color: '#64748B' }}>16 / 收尾</Text>
    </Box>
    <Box style={{ width: '100%', height: 1, background: 'rgba(34,211,238,0.4)', marginTop: 14 }} />

    <Box style={{ flexDirection: 'row', gap: 20, marginTop: 22 }}>
        <Box style={{ width: 560 }}>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#22D3EE' }}>做到了什么（都能当场验）</Text>
            <Box style={{ marginTop: 12, gap: 8 }}>
                <Box style={{ padding: 10, background: '#151B33', borderRadius: 6, borderLeft: '3px solid #22D3EE' }}>
                    <Text style={{ fontSize: 14, color: '#E2E8F0' }}>472 字通知 → 9 条带时间地点的草稿，确认才入库</Text>
                </Box>
                <Box style={{ padding: 10, background: '#151B33', borderRadius: 6, borderLeft: '3px solid #22D3EE' }}>
                    <Text style={{ fontSize: 14, color: '#E2E8F0' }}>忘了原话也能搜到：60/75 条订阅正文进了索引</Text>
                </Box>
                <Box style={{ padding: 10, background: '#151B33', borderRadius: 6, borderLeft: '3px solid #22D3EE' }}>
                    <Text style={{ fontSize: 14, color: '#E2E8F0' }}>问一句有答案 + [1][2] 引用，点开就是原文</Text>
                </Box>
                <Box style={{ padding: 10, background: '#151B33', borderRadius: 6, borderLeft: '3px solid #22D3EE' }}>
                    <Text style={{ fontSize: 14, color: '#E2E8F0' }}>断网 / 没 Key 时核心功能仍可用，且说清降级到哪一步</Text>
                </Box>
                <Box style={{ padding: 10, background: '#151B33', borderRadius: 6, borderLeft: '3px solid #22D3EE' }}>
                    <Text style={{ fontSize: 14, color: '#E2E8F0' }}>工程闭环：66 项自检 · 抓取日志 · 能力体检 · 诊断包（不含用户数据）</Text>
                </Box>
            </Box>
        </Box>

        <Box style={{ width: 580 }}>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#F0ABFC' }}>还没解决的</Text>
            <Box style={{ marginTop: 12, gap: 8 }}>
                <Box style={{ padding: 10, background: '#151B33', borderRadius: 6, borderLeft: '3px solid #F0ABFC' }}>
                    <Text style={{ fontSize: 14, color: '#E2E8F0' }}>语义索引串行构建，上千条要数分钟（已用"可选 + 上限"缓解，未根治）</Text>
                </Box>
                <Box style={{ padding: 10, background: '#151B33', borderRadius: 6, borderLeft: '3px solid #F0ABFC' }}>
                    <Text style={{ fontSize: 14, color: '#E2E8F0' }}>手机上没有语义搜索，信息流也读不到本机服务</Text>
                </Box>
                <Box style={{ padding: 10, background: '#151B33', borderRadius: 6, borderLeft: '3px solid #F0ABFC' }}>
                    <Text style={{ fontSize: 14, color: '#E2E8F0' }}>13 条抓取失败是 robots 不允许 —— 该不该放行得你决定，不该我替你决定</Text>
                </Box>
                <Box style={{ padding: 10, background: '#151B33', borderRadius: 6, borderLeft: '3px solid #F0ABFC' }}>
                    <Text style={{ fontSize: 14, color: '#E2E8F0' }}>同步是全量快照而非增量；也还没有可复现的自动化 Benchmark</Text>
                </Box>
                <Box style={{ padding: 10, background: '#151B33', borderRadius: 6, borderLeft: '3px solid #4F46E5' }}>
                    <Text style={{ fontSize: 14, color: '#22D3EE' }}>下一步</Text>
                    <Text style={{ fontSize: 14, color: '#E2E8F0', marginTop: 3 }}>批量推理 + Web Worker → HNSW → 问答流式输出 → 增量同步 → 补 Benchmark 脚本</Text>
                </Box>
            </Box>
        </Box>
    </Box>

    <Text style={{ fontSize: 14, color: '#64748B', position: 'absolute', left: 60, top: 670 }}>个人工作台 · v0.2.0</Text>
</Slide>
