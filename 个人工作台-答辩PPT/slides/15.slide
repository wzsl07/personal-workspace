<Slide style={{ background: '#0B1020', padding: 60 }}>
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>工程化：别人能跑起来，出错也有去处</Text>
        <Text style={{ fontSize: 14, color: '#64748B' }}>14 / 可靠性</Text>
    </Box>
    <Box style={{ width: '100%', height: 1, background: 'rgba(34,211,238,0.4)', marginTop: 14 }} />

    <Box style={{ flexDirection: 'row', gap: 20, marginTop: 20 }}>
        <Box style={{ width: 560 }}>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#22D3EE' }}>三条命令就能跑起来</Text>
            <Box style={{ marginTop: 12, padding: 12, background: '#0F1428', borderRadius: 6, borderLeft: '3px solid #4F46E5' }}>
                <Text style={{ fontSize: 13, color: '#A5B4FC', fontFamily: 'Consolas' }}>cd personal-os &amp;&amp; npm install &amp;&amp; npm run dev</Text>
                <Text style={{ fontSize: 13, color: '#64748B', marginTop: 4 }}>网页版，零配置看到全部界面</Text>
            </Box>
            <Box style={{ marginTop: 10, padding: 12, background: '#0F1428', borderRadius: 6, borderLeft: '3px solid #4F46E5' }}>
                <Text style={{ fontSize: 13, color: '#A5B4FC', fontFamily: 'Consolas' }}>npm run tauri:build &amp;&amp; npm run dist:portable</Text>
                <Text style={{ fontSize: 13, color: '#64748B', marginTop: 4 }}>桌面版：27MB 安装包 / 便携版 zip，双击即用</Text>
            </Box>
            <Box style={{ marginTop: 10, padding: 12, background: '#0F1428', borderRadius: 6, borderLeft: '3px solid #4F46E5' }}>
                <Text style={{ fontSize: 13, color: '#A5B4FC', fontFamily: 'Consolas' }}>cd aggregator &amp;&amp; python main.py</Text>
                <Text style={{ fontSize: 13, color: '#64748B', marginTop: 4 }}>聚合服务：自动检查依赖并打开管理页</Text>
            </Box>
            <Box style={{ marginTop: 12, flexDirection: 'row', gap: 12 }}>
                <Box style={{ width: 172, padding: 12, background: '#151B33', borderRadius: 8 }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF' }}>66 项</Text>
                    <Text style={{ fontSize: 13, color: '#94A3B8', marginTop: 4 }}>自检脚本全通过</Text>
                </Box>
                <Box style={{ width: 172, padding: 12, background: '#151B33', borderRadius: 8 }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF' }}>17 个</Text>
                    <Text style={{ fontSize: 13, color: '#94A3B8', marginTop: 4 }}>运行时依赖</Text>
                </Box>
                <Box style={{ width: 172, padding: 12, background: '#151B33', borderRadius: 8 }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF' }}>零外链</Text>
                    <Text style={{ fontSize: 13, color: '#94A3B8', marginTop: 4 }}>断网能打开</Text>
                </Box>
            </Box>
        </Box>

        <Box style={{ width: 580 }}>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#22D3EE' }}>会出什么错 → 系统怎么处理</Text>
            <Box style={{ marginTop: 12, gap: 8 }}>
                <Box style={{ padding: 10, background: '#151B33', borderRadius: 6, borderLeft: '3px solid #F0ABFC' }}>
                    <Text style={{ fontSize: 14, color: '#FFFFFF' }}>没填 Key / 断网</Text>
                    <Text style={{ fontSize: 13, color: '#94A3B8', marginTop: 3 }}>主模型 → 本地 Ollama → 本地规则；界面直说"本地规则生成"</Text>
                </Box>
                <Box style={{ padding: 10, background: '#151B33', borderRadius: 6, borderLeft: '3px solid #F0ABFC' }}>
                    <Text style={{ fontSize: 14, color: '#FFFFFF' }}>模型输出不是 JSON / 带代码围栏</Text>
                    <Text style={{ fontSize: 13, color: '#94A3B8', marginTop: 3 }}>剥围栏 → 白名单过滤 → 字段兜底；报错带服务端原文而不是只报状态码</Text>
                </Box>
                <Box style={{ padding: 10, background: '#151B33', borderRadius: 6, borderLeft: '3px solid #F0ABFC' }}>
                    <Text style={{ fontSize: 14, color: '#FFFFFF' }}>抓取失败 / 超时</Text>
                    <Text style={{ fontSize: 13, color: '#94A3B8', marginTop: 3 }}>退避 1m→5m→15m→1h→4h；来源卡片显示健康状态与最近错误</Text>
                </Box>
                <Box style={{ padding: 10, background: '#151B33', borderRadius: 6, borderLeft: '3px solid #F0ABFC' }}>
                    <Text style={{ fontSize: 14, color: '#FFFFFF' }}>连续失败 5 次</Text>
                    <Text style={{ fontSize: 13, color: '#94A3B8', marginTop: 3 }}>自动隔离，但可逆 —— 一键清零并立刻到期，不会"悄悄死掉"</Text>
                </Box>
                <Box style={{ padding: 10, background: '#151B33', borderRadius: 6, borderLeft: '3px solid #F0ABFC' }}>
                    <Text style={{ fontSize: 14, color: '#FFFFFF' }}>聚合服务没启动 / robots 不允许</Text>
                    <Text style={{ fontSize: 13, color: '#94A3B8', marginTop: 3 }}>前者 1.5 秒快速失败、退回上次快照并标注时间；后者不重试，把原因写清楚</Text>
                </Box>
            </Box>
        </Box>
    </Box>

    <Box style={{ marginTop: 12, padding: 16, background: '#151B33', borderRadius: 8, borderLeft: '3px solid #4F46E5' }}>
        <Text style={{ fontSize: 18, color: '#E2E8F0', lineHeight: 1.5 }}>
            <span style={{ fontWeight: 'bold', color: '#22D3EE' }}>不允许"灰着但不解释"</span>
            ：每一项能力不可用都必须给出一句人话原因 + 修复入口。构建期还有个命令名静态比对脚本，把"点了没反应"这类只有运行时才暴露的静默失败提前拦掉。
        </Text>
    </Box>

    <Text style={{ fontSize: 14, color: '#64748B', position: 'absolute', left: 60, top: 670 }}>个人工作台 · v0.2.0</Text>
</Slide>
